[options]
size 100
tags COVERED UNCOVERED NOCHANGE EQGAP EQTIMEOUT

[script]
read_verilog -sv ../rtl/fifo.v
prep -top fifo

[files]
../rtl/fifo.v

[logic]
# test_sim : the testbench under evaluation, run against the mutant
# test_eq  : formal BMC miter, golden vs mutant, same inputs -> same outputs?
#
# tb_okay  == testbench PASSED on the mutant  (it did NOT notice)
# eq_okay  == formal says mutant is equivalent (nothing TO notice)

tb_okay = (result("test_sim") == "PASS")
eq_res  = result("test_eq")
eq_okay = (eq_res in ("PASS", "TIMEOUT"))   # no counterexample within the bound
if eq_res == "TIMEOUT":
    tag("EQTIMEOUT")   # solver gave up: treated as equivalent, but flagged so you can rerun deeper

if tb_okay and not eq_okay:
    tag("UNCOVERED")   # real bug, bench missed it  -> classify.py decides stim vs checker
elif not tb_okay and not eq_okay:
    tag("COVERED")     # real bug, bench caught it
elif tb_okay and eq_okay:
    tag("NOCHANGE")    # equivalent mutant, nothing to catch (filtered out of the score)
elif not tb_okay and eq_okay:
    tag("EQGAP")       # bench failed but formal says equivalent -> bench is flaky, or BMC depth too short
else:
    assert 0

[report]
cov = tags("COVERED")
unc = tags("UNCOVERED")
if cov + unc:
    print("Mutation score (COVERED / (COVERED+UNCOVERED)): %d/%d = %.1f%%" % (cov, cov+unc, 100.0*cov/(cov+unc)))
print("Equivalent mutants filtered (NOCHANGE): %d  (of which solver timeouts: %d)" % (tags("NOCHANGE"), tags("EQTIMEOUT")))
if tags("EQGAP"):
    print("WARNING: %d EQGAP mutants (bench failed on a formally-equivalent mutant)" % tags("EQGAP"))

[test test_sim]
expect PASS FAIL
run bash $PRJDIR/test_sim.sh

[test test_eq]
expect PASS FAIL TIMEOUT
run bash $PRJDIR/test_eq.sh
